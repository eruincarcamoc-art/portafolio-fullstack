# Sin ninguna variable, todo corre localmente (embeddings hash + LLM extractivo + PGlite): sin claves ni red.
# --- Modelos reales (opcional) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# EMBED_PROVIDER=voyage          # Anthropic no ofrece embeddings; Voyage es el proveedor recomendado
# VOYAGE_API_KEY=pa-...
# --- Costes: pon la tarifa vigente (USD por millón de tokens) para ver el gasto real ---
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
# --- Producción ---
# DATABASE_URL=postgres://user:pass@host:5432/db   # requiere la extensión pgvector
# ADMIN_TOKEN=change-me
# DAILY_TOKEN_BUDGET=200000
# RATE_LIMIT_PER_MIN=20
