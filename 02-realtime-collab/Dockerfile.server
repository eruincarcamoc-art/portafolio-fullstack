FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY packages/core/package.json packages/core/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY packages/core packages/core
COPY apps/server apps/server
RUN npm run build -w apps/server

FROM node:22-alpine
ENV NODE_ENV=production DATA_DIR=/data
WORKDIR /app
RUN npm init -y >/dev/null && npm i --omit=dev ws@8 zod@4 && mkdir /data && chown node /data
COPY --from=build /app/apps/server/dist/main.js ./main.js
USER node
VOLUME /data
EXPOSE 4100
HEALTHCHECK --interval=15s --timeout=3s CMD wget -qO- http://localhost:4100/health || exit 1
CMD ["node", "main.js"]
